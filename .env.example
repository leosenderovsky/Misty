# VITE_DEMO_BRAND_NAME: Nombre de marca para el banner DEMO (vacío hasta definir la marca).
VITE_DEMO_BRAND_NAME=
# VITE_DEMO_BRAND_URL: URL HTTP(S) del servicio a enlazar en el banner DEMO (vacía hasta definirla).
VITE_DEMO_BRAND_URL=

# VITE_SITE_URL: Public origin used for absolute canonical and social metadata URLs.
# On Netlify, URL is used in production; DEPLOY_PRIME_URL is preferred for previews and branch deploys.
VITE_SITE_URL=
