# VITE_DEMO_BRAND_NAME: Nombre de marca para el banner DEMO (por defecto Tienda ON!).
VITE_DEMO_BRAND_NAME=
# VITE_DEMO_BRAND_URL: URL HTTP(S) del servicio a enlazar en el banner DEMO (por defecto vacía mientras https://tiendaon.com.ar no exista).
VITE_DEMO_BRAND_URL=

# VITE_SITE_URL: Origen publico para URLs canonical absolutas y metadatos sociales.
# En Netlify, URL se usa en produccion; DEPLOY_PRIME_URL tiene prioridad en previews y branch deploys.
VITE_SITE_URL=
